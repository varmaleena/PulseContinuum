BACKEND_URL=http://127.0.0.1:8000
BACKEND_API_TOKEN=
# Local synthetic demo allows both profile views. Public hosting must require authentication.
REQUIRE_JUDGE_AUTH=false
# Admin credentials may inspect both profiles. Use distinct, strong passwords.
JUDGE_USERNAME=
JUDGE_PASSWORD=
# Care credentials cannot access raw telemetry or elevate to admin.
CARE_USERNAME=
CARE_PASSWORD=
